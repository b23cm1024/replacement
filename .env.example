# WorkIQ AI Search Backend — Environment Variables
# ------------------------------------------------
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to version control!

# ── PostgreSQL Database (AWS RDS or local) ─────────────────────────────────────
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=workiq

# ── LLM API Keys ───────────────────────────────────────────────────────────────
# OpenAI (used as fallback)
OPENAI_API_KEY=sk-proj-...

# Groq (used for LLM chunking + answer generation — free & fast)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── GitHub API ─────────────────────────────────────────────────────────────────
# Required for POST /ingest/github endpoint
# Generate at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scopes: repo (read access to public/private repos)
GITHUB_TOKEN=github_pat_...
