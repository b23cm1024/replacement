# .env.example — Copy this to .env and fill in your values. NEVER commit .env to git.

# ── PostgreSQL (used in local dev via individual vars OR as a single URL) ───────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/zephyr_db

# ── Alternative: individual vars (used if DATABASE_URL is not set) ──────────────
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zephyr_db

# ── Qdrant Vector DB ─────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── LLM: Groq (for answer generation) ───────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Vision AI: OpenAI (for image descriptions inside PDFs) ───────────────────────
OPENAI_API_KEY=sk-...

# ── GitHub (for private repo ingestion) ──────────────────────────────────────────
GITHUB_TOKEN=ghp_...
